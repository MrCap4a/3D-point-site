# Публичный URL сайта (используется в SEO, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://3-dpoint.ru

# База данных (SQLite на старте, см. prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессии администратора (сгенерировать длинную случайную строку)
ADMIN_SESSION_SECRET=""

# Логин администратора и хэш пароля (bcrypt), используются только на сервере.
# Сгенерировать хэш: node -e "console.log(require('bcryptjs').hashSync('пароль', 10))"
#
# ВАЖНО: bcrypt-хэш содержит символы "$" (например, $2b$10$...). Next.js
# поддерживает подстановку переменных в .env через "$", поэтому каждый "$"
# в хэше нужно экранировать обратным слэшем, иначе хэш будет обрезан и
# вход в админку перестанет работать. Пример:
#   было:  $2b$10$6/kXk2o.....
#   нужно: \$2b\$10\$6/kXk2o.....
ADMIN_LOGIN=""
ADMIN_PASSWORD_HASH=""

# Каталог хранения загруженных файлов заявок и изображений портфолио
UPLOADS_DIR="./uploads"

# Telegram-интеграция (следующий этап, пока не используется кодом)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
